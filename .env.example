# Copy this file to .env and fill in the real values:
#
#   cp .env.example .env
#
# .env is gitignored and never leaves the machine it sits on. Docker Compose
# reads it automatically from the directory next to docker-compose.yml —
# there is nothing else to wire up.
#
# On the NAS this file lives at:
#   /volume1/Martin/Webhosting/docker/webhosting/sales-calendar/.env
# The deploy workflow explicitly excludes .env from the copy, so deploying
# never overwrites the one already on the server.

# ── Outbound email ──────────────────────────────────────────────────────
#
# SMTP_PASSWORD must be a Google **app password**, not the account password.
# Google rejects the account password for SMTP whenever 2-Step Verification
# is on — and 2SV has to be on before app passwords can be created at all.
# Generate one at https://myaccount.google.com/apppasswords
#
# It is shown once, as four groups of four characters ("abcd efgh ijkl mnop").
# Paste it here WITHOUT the spaces. Treat it like the account password: it
# bypasses 2FA for mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seasonal.sales.tracking@gmail.com
SMTP_PASSWORD=

# The name recipients see as the sender. SMTP_FROM defaults to SMTP_USER.
SMTP_FROM_NAME=Sale Season
SMTP_FROM=

# Set to 1 to log emails to the container output instead of sending them.
# Useful locally; leave unset in production. Without it, the backend refuses
# to start when SMTP_USER/SMTP_PASSWORD are missing, rather than coming up
# and silently failing at 08:00 on the morning a reminder was due.
#MAIL_DRY_RUN=1

# ── Site ────────────────────────────────────────────────────────────────
#
# Used to build the confirmation and unsubscribe links inside emails, so it
# has to be the address people actually reach the site on.
SITE_URL=https://sales.pfeifhofer.dev

# ── Reminder schedule ───────────────────────────────────────────────────
#
# Standard five-field cron. Default: every day at 08:00 Vienna time.
REMINDER_CRON=0 8 * * *
REMINDER_TZ=Europe/Vienna

# ── Web Push (optional) ─────────────────────────────────────────────────
#
# Powers the installable app's push notifications. Without these, push is
# simply unavailable and the UI hides it — unlike SMTP, missing keys do not
# stop the backend starting, because email is the baseline and push is the
# extra.
#
# Generate a pair ONCE with:
#   docker compose exec backend node generate-vapid.js
# Rotating them invalidates every existing push subscription, so keep them.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address the push services use if something is wrong with our
# requests. Must be a mailto: or https: URL.
VAPID_SUBJECT=mailto:seasonal.sales.tracking@gmail.com
